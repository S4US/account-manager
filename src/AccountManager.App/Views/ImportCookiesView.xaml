<UserControl
    x:Class="AccountManager.App.Views.ImportCookiesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="540">
    <StackPanel>
        <TextBlock Style="{StaticResource BodyText}" Text="Paste one .ROBLOSECURITY session cookie per line. Each one is checked with Roblox and stored encrypted on this PC." />
        <ui:InfoBar
            Margin="0,12,0,12"
            IsClosable="False"
            IsOpen="True"
            Message="Only import cookies for accounts you own. Anyone with a session cookie is signed in as that account."
            Severity="Warning"
            Title="Keep cookies private" />
        <ui:TextBox
            x:Name="Input"
            Height="200"
            PlaceholderText="_|WARNING:-DO-NOT-SHARE-THIS…"
            Style="{StaticResource MonoTextBox}" />
    </StackPanel>
</UserControl>
