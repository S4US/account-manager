<Page
    x:Class="AccountManager.App.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:AccountManager.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AccountManager.App.ViewModels"
    Title="Overview"
    ScrollViewer.CanContentScroll="False"
    d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
    mc:Ignorable="d">
    <Page.Resources>
        <conv:ToneToBrushConverter x:Key="ToneToBrush" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:PercentConverter x:Key="Percent" />
        <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />

        <Style x:Key="StatCard" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Padding" Value="{StaticResource CardPadding}" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Meter" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Height" Value="4" />
            <Setter Property="Margin" Value="0,10,0,6" />
            <Setter Property="Maximum" Value="100" />
        </Style>
        <Style x:Key="ActionButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Overview" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding CapacityText}" />

            <!--  Stats  -->
            <UniformGrid Margin="0,20,0,0" Columns="4">
                <ui:Card Margin="0,0,8,0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Clients running" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding RunningClients}" />
                        <TextBlock Margin="0,20,0,0" Style="{StaticResource CaptionText}" Text="{Binding TotalAccounts, StringFormat='of {0} accounts'}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="4,0,4,0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Processor" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding CpuText}" />
                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding CpuPercent, Converter={StaticResource Percent}}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="Whole system" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="4,0,4,0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Memory" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding MemoryText}" />
                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding MemoryPercent, Converter={StaticResource Percent}}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding MemoryDetail}" />
                        <!--  Windows' commit limit: what runs out first with many clients, even with RAM free  -->
                        <StackPanel ToolTip="Windows' memory limit: RAM plus page file. Every client's memory counts toward it, even the part a memory limit or trim moves out of RAM. When it's full, programs crash and the desktop can freeze. A larger page file raises it.">
                            <ProgressBar Value="{Binding CommitPercent, Converter={StaticResource Percent}}">
                                <ProgressBar.Style>
                                    <Style BasedOn="{StaticResource Meter}" TargetType="ProgressBar">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommitTone}" Value="{x:Static vm:StatusTone.Caution}">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CommitTone}" Value="{x:Static vm:StatusTone.Critical}">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding CommitText}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="8,0,0,0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Used by Roblox" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding ClientsMemoryText}" />
                        <TextBlock Margin="0,20,0,0" Style="{StaticResource CaptionText}" Text="{Binding ClientsMemoryDetail}" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!--  Quick actions  -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Quick actions" />
                    <UniformGrid Margin="0,0,-8,0" Columns="2">
                        <ui:Button
                            Command="{Binding TileWindowsCommand}"
                            Content="Tile windows"
                            Style="{StaticResource ActionButton}"
                            ToolTip="Arrange every client in a grid with normal window frames">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Grid24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            Command="{Binding CompactTileCommand}"
                            Content="Compact tile"
                            Style="{StaticResource ActionButton}"
                            ToolTip="Remove window frames so clients can be smaller than Windows normally allows. Tile windows puts the frames back">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="GridDots24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Command="{Binding MinimizeAllCommand}" Content="Minimize all" Style="{StaticResource ActionButton}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowMinimize24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            Command="{Binding TrimMemoryCommand}"
                            Content="Trim memory now"
                            Style="{StaticResource ActionButton}"
                            ToolTip="Ask every client to release memory it isn't using">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Broom24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            Command="{Binding AntiAfkNowCommand}"
                            Content="Anti-AFK now"
                            Style="{StaticResource ActionButton}"
                            ToolTip="Nudge every client with anti-AFK turned on">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Timer24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            Appearance="Danger"
                            Command="{Binding CloseAllCommand}"
                            Content="Close all clients"
                            Style="{StaticResource ActionButton}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="DismissCircle24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </UniformGrid>

                    <!--  Scheduler  -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Timer" />
                    <ui:Card Padding="{StaticResource CardPadding}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding IsScheduled, Converter={StaticResource InverseBool}}"
                                    ItemsSource="{Binding ScheduleActions}"
                                    SelectedItem="{Binding SelectedScheduleAction}" />
                                <ui:NumberBox
                                    Grid.Column="2"
                                    IsEnabled="{Binding IsScheduled, Converter={StaticResource InverseBool}}"
                                    LargeChange="30"
                                    MaxDecimalPlaces="0"
                                    Maximum="2880"
                                    Minimum="1"
                                    SmallChange="5"
                                    ToolTip="Minutes from now"
                                    Value="{Binding ScheduleMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button
                                    Grid.Column="4"
                                    Appearance="Primary"
                                    Command="{Binding ScheduleCommand}"
                                    Content="Start"
                                    Visibility="{Binding IsScheduled, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ui:Button
                                    Grid.Column="4"
                                    Command="{Binding CancelScheduleCommand}"
                                    Content="Cancel"
                                    Visibility="{Binding IsScheduled, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Symbol="Clock24" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding ScheduleStatus}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!--  Recent activity  -->
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Recent activity" />
                    <ui:Card Padding="{StaticResource CardPadding}">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Recent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LogEntryViewModel}">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse
                                                Margin="0,5,10,0"
                                                VerticalAlignment="Top"
                                                Fill="{Binding Tone, Converter={StaticResource ToneToBrush}}"
                                                Style="{StaticResource StatusDot}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding Time}"
                                                Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Grid.Column="2" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap">
                                                <Run FontWeight="SemiBold" Text="{Binding AccountPrefix, Mode=OneWay}" /><Run Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Message, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                Style="{StaticResource CaptionText}"
                                Text="Nothing yet. Launches, crashes and restarts show up here."
                                Visibility="{Binding Recent.Count, Converter={StaticResource EmptyToVisibility}}" />
                        </Grid>
                    </ui:Card>
                </StackPanel>
            </Grid>

            <ui:InfoBar
                Margin="0,24,0,0"
                IsClosable="False"
                IsOpen="True"
                Message="Only one Roblox client can run at a time, and standby memory purging is off. Restart the app as administrator, or turn on &quot;Run as administrator&quot; in Performance."
                Severity="Informational"
                Title="Running without administrator rights"
                Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}" />
        </StackPanel>
    </ScrollViewer>
</Page>
