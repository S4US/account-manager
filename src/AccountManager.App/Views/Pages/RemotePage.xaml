<Page
    x:Class="AccountManager.App.Views.Pages.RemotePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:AccountManager.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AccountManager.App.ViewModels"
    Title="Remote control"
    ScrollViewer.CanContentScroll="False"
    d:DataContext="{d:DesignInstance Type=vm:RemoteViewModel}"
    mc:Ignorable="d">
    <Page.Resources>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Remote control" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="A small web panel for checking on and launching accounts from your phone or another computer." />

            <!--  Status  -->
            <ui:Card Margin="0,20,0,0" Padding="{StaticResource CardPadding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Margin="0,0,12,0">
                        <Ellipse.Style>
                            <Style BasedOn="{StaticResource StatusDot}" TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingHeader}" Text="Remote panel" />
                        <TextBlock Style="{StaticResource SettingDescription}" Text="{Binding Status}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled}" />
                </Grid>
            </ui:Card>

            <!--  Connection  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Connection" />
            <ui:CardControl Style="{StaticResource SettingCard}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingHeader}" Text="Port" />
                        <TextBlock Style="{StaticResource SettingDescription}" Text="Between 1024 and 65535. Change it if another program already uses this one." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:NumberBox
                    Width="140"
                    MaxDecimalPlaces="0"
                    Maximum="65535"
                    Minimum="1024"
                    SmallChange="1"
                    Value="{Binding Port}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource SettingCard}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingHeader}" Text="Allow other devices on your network" />
                        <TextBlock Style="{StaticResource SettingDescription}" Text="Needed to use the panel from your phone. Windows may ask to allow the app through the firewall. Only turn this on for networks you trust." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding AllowLan}" />
            </ui:CardControl>

            <!--  Token  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Access token" />
            <ui:Card Padding="{StaticResource CardPadding}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="The panel asks for this token before it shows anything. Anyone who has it can launch and stop your accounts, so keep it private." />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Padding="12,8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource MonoFont}"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding MaskedToken}"
                                TextTrimming="CharacterEllipsis" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" Orientation="Horizontal">
                            <ui:Button
                                Command="{Binding CopyTokenCommand}"
                                Style="{StaticResource RowIconButton}"
                                ToolTip="Copy token">
                                <ui:SymbolIcon Symbol="Copy24" />
                            </ui:Button>
                            <ToggleButton
                                Width="32"
                                Height="32"
                                Margin="4,0,0,0"
                                Padding="0"
                                IsChecked="{Binding TokenRevealed}"
                                ToolTip="Show or hide the token">
                                <ui:SymbolIcon Symbol="Eye24" />
                            </ToggleButton>
                            <ui:Button
                                Margin="8,0,0,0"
                                Command="{Binding RegenerateTokenCommand}"
                                Content="New token">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!--  Addresses  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Panel addresses" />
            <ui:Card Padding="{StaticResource CardPadding}">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Addresses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PanelAddress}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionText}"
                                        Text="{Binding Label}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource MonoFont}"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Url}"
                                        TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <ui:Button
                                            Command="{Binding DataContext.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource RowIconButton}"
                                            ToolTip="Copy address">
                                            <ui:SymbolIcon Symbol="Copy24" />
                                        </ui:Button>
                                        <ui:Button
                                            Command="{Binding DataContext.OpenPanelCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource RowIconButton}"
                                            ToolTip="Open in browser, signed in">
                                            <ui:SymbolIcon Symbol="Open24" />
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Style="{StaticResource CaptionText}"
                        Text="Turn the panel on to see its addresses."
                        Visibility="{Binding Addresses.Count, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
            </ui:Card>
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource CaptionText}"
                Text="On another device, open a local-network address and enter the token. The panel works only while this app is running." />
        </StackPanel>
    </ScrollViewer>
</Page>
