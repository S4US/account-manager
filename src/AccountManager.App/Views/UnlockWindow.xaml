<ui:FluentWindow
    x:Class="AccountManager.App.Views.UnlockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Account manager"
    Width="420"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">
    <StackPanel>
        <ui:TitleBar
            Title="Account manager"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Margin="32,12,32,28">
            <Image
                Width="48"
                Height="48"
                HorizontalAlignment="Left"
                Source="pack://application:,,,/Assets/logo.png" />
            <TextBlock
                Margin="0,16,0,0"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Enter your master password" />
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource CaptionText}"
                Text="Your saved sign-ins are locked until you enter it." />

            <ui:PasswordBox
                x:Name="PasswordInput"
                Margin="0,20,0,0"
                PlaceholderText="Master password" />
            <TextBlock
                x:Name="ErrorText"
                Margin="2,8,0,0"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionText}"
                Visibility="Collapsed" />

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:HyperlinkButton
                    x:Name="ResetButton"
                    Padding="0"
                    VerticalAlignment="Center"
                    Click="OnResetClick"
                    Content="Forgot it?" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:ProgressRing
                        x:Name="Busy"
                        Width="20"
                        Height="20"
                        Margin="0,0,12,0"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />
                    <ui:Button
                        x:Name="UnlockButton"
                        MinWidth="100"
                        Appearance="Primary"
                        Click="OnUnlockClick"
                        Content="Unlock"
                        IsDefault="True" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
