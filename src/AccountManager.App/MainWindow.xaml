<ui:FluentWindow
    x:Class="AccountManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:AccountManager.App.Converters"
    xmlns:pages="clr-namespace:AccountManager.App.Views.Pages"
    xmlns:services="clr-namespace:AccountManager.App.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Account manager"
    Width="1280"
    Height="820"
    MinWidth="980"
    MinHeight="620"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <conv:ToneToBrushConverter x:Key="ToneToBrush" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Title="Account manager" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="232"
            PaneDisplayMode="Left"
            Transition="FadeInWithSlide">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Overview" TargetPageType="{x:Type pages:DashboardPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Accounts" TargetPageType="{x:Type pages:AccountsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="People24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Performance" TargetPageType="{x:Type pages:PerformancePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Gauge24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Remote control" TargetPageType="{x:Type pages:RemotePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PhoneLaptop24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Activity" TargetPageType="{x:Type pages:ActivityPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="History24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <!--  Notifications: small cards stacked in the bottom-right corner  -->
                <ItemsControl
                    Width="380"
                    Margin="0,0,24,24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    ItemsSource="{x:Static services:Toasts.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type services:Toast}">
                            <Border
                                Margin="0,8,0,0"
                                Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="18"
                                        Opacity="0.35"
                                        ShadowDepth="4"
                                        Color="Black" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!--  Colored edge showing the kind of message  -->
                                    <Border
                                        Background="{Binding Tone, Converter={StaticResource ToneToBrush}}"
                                        CornerRadius="8,0,0,8" />
                                    <ui:SymbolIcon
                                        Grid.Column="1"
                                        Margin="12,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Filled="True"
                                        Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}"
                                        Symbol="{Binding Icon}" />
                                    <StackPanel
                                        Grid.Column="2"
                                        Margin="0,12,0,12"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Title}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource CaptionText}"
                                            Text="{Binding Message}"
                                            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Column="3"
                                        Width="28"
                                        Height="28"
                                        Margin="8,8,8,0"
                                        Padding="0"
                                        VerticalAlignment="Top"
                                        Appearance="Transparent"
                                        BorderThickness="0"
                                        Click="OnToastCloseClick"
                                        ToolTip="Dismiss">
                                        <ui:SymbolIcon FontSize="12" Symbol="Dismiss24" />
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
